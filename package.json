{
  "name": "nonebotmaker-serverless",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:client\"",
    "dev:api": "tsx watch src/server/local.ts",
    "dev:client": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:worker": "npm run build && wrangler deploy --dry-run --config wrangler.example.jsonc --outdir .wrangler-build",
    "build:edgeone": "npm run build && esbuild \"edge-functions/api/[[default]].ts\" --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/edge-functions/api/[[default]].js",
    "build:esa": "npm run build && esbuild edge-routine/index.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/edge-routine/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@hono/node-server": "^2.1.5",
    "antd": "^6.0.0",
    "hono": "^4.11.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.40.0"
  }
}
